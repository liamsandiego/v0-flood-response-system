# =============================================================================
# RapidRelay – Environment Variables
# Copy this file to .env and fill in values.
# =============================================================================

# --- Backend (FastAPI) -------------------------------------------------------

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Phase 2 — currently unused, data is CSV/in-memory)
# DATABASE_URL=postgresql://rapidrelay:password@localhost:5432/rapidrelay

# SMS Gateway (Phase 2 — placeholder)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Frontend (Next.js) ------------------------------------------------------

# API base URL (the FastAPI backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- NASA GIBS (no key needed — public) --------------------------------------
# Included for documentation only. The frontend calls GIBS WMS directly.
GIBS_WMS_URL=https://gibs.earthdata.nasa.gov/wms/epsg3857/best/wms.cgi

# --- Copernicus / STAC (Phase 2) --------------------------------------------
# STAC_CATALOG_URL=https://earth-search.aws.element84.com/v1
# COPERNICUS_USERNAME=
# COPERNICUS_PASSWORD=
