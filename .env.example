# =============================================================================
# RapidRelay Environment Configuration
# Copy to .env and fill in your values
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite database location (shared by backend, lora_bridge, sync_engine)
# Linux/RPi default: /home/rapidrelay/db/local.db
# Windows default: D:/raprelay/db/local.db
LOCAL_DB_PATH=/home/rapidrelay/db/local.db

# ── LoRa / MQTT ──────────────────────────────────────────────────────────────
# LoRa mode: 'mqtt' (ChirpStack), 'serial' (direct USB), 'simulate' (dev)
LORA_MODE=mqtt

# MQTT broker (ChirpStack Mosquitto)
MQTT_BROKER=localhost
MQTT_PORT=1883

# Serial port for direct TTGO connection (fallback mode)
LORA_SERIAL_PORT=/dev/ttyUSB0

# ── Sync Engine ──────────────────────────────────────────────────────────────
# SQLite → Supabase sync interval (seconds)
SYNC_INTERVAL_S=300

# ── Supabase (Cloud Sync) ────────────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Groq API (cloud LLM for AI interpretation)
GROQ_API_KEY=gsk_...

# Ollama (local LLM for Woody explanations)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
# WebSocket broadcast interval (seconds)
WS_BROADCAST_INTERVAL=5.0

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8001

# ── NASA GIBS (public, no key needed) ────────────────────────────────────────
GIBS_WMS_URL=https://gibs.earthdata.nasa.gov/wms/epsg3857/best/wms.cgi

